    // Bodies. A radius is no longer drawn: registry revision 2 draws a mean density beside the mass and
    // derives the radius from the two, so a body's size and density can no longer contradict each other.
    // Densities are kg/m^3: rock and iron above 3,000, ice and volatiles below it.
    //
    // A body that has ground to stand on says so with the `solid-surface` tag, which grammar version 6's
    // surface anchor reads: a gas giant declares none and takes no region, however large it is
    // (decision 0061). The orbit connector's tags decide where a body may sit and what may orbit it. It PROVIDES the zones
    // it can occupy, which grammar version 3 demands per band, and a mass class; it REQUIRES of its own
    // moons a class below its own, so a moon can no longer outweigh its planet. Nothing provides
    // "mass-none", so the smallest bodies keep no moons at all.
    { "id": 14, "label": "small-rocky-body", "category": "planet", "tags": ["solid-surface"],
      "parameters": { "mass": [30, 2000], "density": [3300, 8000], "albedo": [3000, 45000], "pole-right-ascension": [-2147483648, 2147483647], "prime-meridian-phase": [-2147483648, 2147483647], "pole-declination": [-536870912, 536870912], "sidereal-period": [720000, 172800000], "body-type": ["rocky"], "relief-amplitude": [180, 900], "relief-roughness": [30000, 48000], "relief-wavelength": [512, 4096], "relief-ridging": [44000, 62000], "biomes": [3, 4, "for-rocky"], "sea-level": [-1024, -1024] , "surface": ["for-rocky"] },
